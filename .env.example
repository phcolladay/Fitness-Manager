# Django
DJANGO_ENV=development
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=change-me
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_LOG_LEVEL=INFO
DJANGO_SESSION_TIMEOUT_SECONDS=7200

# Database (optional)
# Prefer DATABASE_URL in production (example):
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/fitness_manager
DATABASE_URL=
# Or configure via explicit variables:
DJANGO_DB_ENGINE=
DJANGO_DB_NAME=
DJANGO_DB_USER=
DJANGO_DB_PASSWORD=
DJANGO_DB_HOST=
DJANGO_DB_PORT=

# Upload limits
FOOD_PHOTO_MAX_UPLOAD_SIZE=5242880
DJANGO_DATA_UPLOAD_MAX_MEMORY_SIZE=10485760

# Optional production hardening (set to 1 behind HTTPS/proxy)
DJANGO_SECURE_PROXY_SSL_HEADER=0
DJANGO_SECURE_SSL_REDIRECT=0
DJANGO_SECURE_COOKIES=0

# Integrations
USDA_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Email
# In production, configure SMTP to send real password-reset/notification emails.
# Example:
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.your-provider.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=your-user
# EMAIL_HOST_PASSWORD=your-password
# EMAIL_USE_TLS=1
# EMAIL_USE_SSL=0
# EMAIL_TIMEOUT_SECONDS=10
EMAIL_BACKEND=
EMAIL_HOST=
EMAIL_PORT=
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=
EMAIL_USE_SSL=
EMAIL_TIMEOUT_SECONDS=
DEFAULT_FROM_EMAIL=noreply@localhost
DEFAULT_NOTIFICATION_EMAIL=
