# Django
DJANGO_ENV=development
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=change-me
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_LOG_LEVEL=INFO
DJANGO_SESSION_TIMEOUT_SECONDS=7200

# Database (optional)
# Prefer DATABASE_URL in production (example):
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/fitness_manager
DATABASE_URL=
# Or configure via explicit variables:
DJANGO_DB_ENGINE=
DJANGO_DB_NAME=
DJANGO_DB_USER=
DJANGO_DB_PASSWORD=
DJANGO_DB_HOST=
DJANGO_DB_PORT=

# Upload limits
FOOD_PHOTO_MAX_UPLOAD_SIZE=5242880
DJANGO_DATA_UPLOAD_MAX_MEMORY_SIZE=10485760

# Optional production hardening (set to 1 behind HTTPS/proxy)
DJANGO_SECURE_PROXY_SSL_HEADER=0
DJANGO_SECURE_SSL_REDIRECT=0
DJANGO_SECURE_COOKIES=0

# Integrations
USDA_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Email
DEFAULT_FROM_EMAIL=noreply@localhost
DEFAULT_NOTIFICATION_EMAIL=
