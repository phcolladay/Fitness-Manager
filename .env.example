# Django
DJANGO_ENV=development
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=change-me
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_LOG_LEVEL=INFO
DJANGO_SESSION_TIMEOUT_SECONDS=7200

# Upload limits
FOOD_PHOTO_MAX_UPLOAD_SIZE=5242880
DJANGO_DATA_UPLOAD_MAX_MEMORY_SIZE=10485760

# Optional production hardening (set to 1 behind HTTPS/proxy)
DJANGO_SECURE_PROXY_SSL_HEADER=0
DJANGO_SECURE_SSL_REDIRECT=0
DJANGO_SECURE_COOKIES=0

# Integrations
USDA_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Email delivery
# Namecheap Private Email / commercial SMTP.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
DEFAULT_FROM_EMAIL=notify@terrierfit.com
DEFAULT_NOTIFICATION_EMAIL=notify@terrierfit.com
EMAIL_HOST=mail.privateemail.com
EMAIL_PORT=465
EMAIL_HOST_USER=notify@terrierfit.com
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=0
EMAIL_USE_SSL=1
EMAIL_TIMEOUT_SECONDS=10
