# Django
DJANGO_ENV=development
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=change-me
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_LOG_LEVEL=INFO
DJANGO_SESSION_TIMEOUT_SECONDS=7200

# Database (optional)
# Prefer DATABASE_URL in production (example):
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/fitness_manager
DATABASE_URL=
# Or configure via explicit variables:
DJANGO_DB_ENGINE=
DJANGO_DB_NAME=
DJANGO_DB_USER=
DJANGO_DB_PASSWORD=
DJANGO_DB_HOST=
DJANGO_DB_PORT=

# Upload limits
FOOD_PHOTO_MAX_UPLOAD_SIZE=5242880
DJANGO_DATA_UPLOAD_MAX_MEMORY_SIZE=10485760

# Optional production hardening (set to 1 behind HTTPS/proxy)
DJANGO_SECURE_PROXY_SSL_HEADER=0
DJANGO_SECURE_SSL_REDIRECT=0
DJANGO_SECURE_COOKIES=0

# Integrations
USDA_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Email (AWS SES API via boto3)
# Use IAM Role in production when possible (no static AWS keys in env).
EMAIL_BACKEND=fitness_manager.email_backends.SESEmailBackend
SES_REGION=us-east-1
SES_FROM_EMAIL=
SES_MAX_RETRIES=2
SES_RETRY_BACKOFF_SECONDS=0.6
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Optional defaults/fallback behavior.
DEFAULT_FROM_EMAIL=noreply@localhost
DEFAULT_NOTIFICATION_EMAIL=

# Optional SMTP settings for custom/fallback backend usage only.
EMAIL_HOST=
EMAIL_PORT=
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=
EMAIL_USE_SSL=
EMAIL_TIMEOUT_SECONDS=
